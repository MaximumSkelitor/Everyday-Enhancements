{
  "schemaVersion": 1,
  "id": "everydayenhancements",
  "version": "${version}",
  "name": "Everyday Enhancements",
  "icon": "assets/everydayenhancements/icon.png",
  "description": "Adds trash cans and quality-of-life client features.",
  "authors": ["MaximumSkelitor"],
  "contact": {
    "sources": "https://github.com/MaximumSkelitor/Trash-Can-Mod",
    "issues": "https://github.com/MaximumSkelitor/Trash-Can-Mod/issues/"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.weberpackage.everydayenhancements.client.EverydayEnhancementsDataGenerator"
    ],
    "client": [
      "com.weberpackage.everydayenhancements.client.EverydayEnhancementsClient"
    ],
    "main": [
      "com.weberpackage.everydayenhancements.EverydayEnhancementsFabric"
    ],
    "modmenu": [
      "com.weberpackage.everydayenhancements.client.EverydayEnhancementsModMenu"
    ]
  },
  "mixins": [
    "everydayenhancements.mixins.json",
    {
      "config": "everydayenhancements.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
